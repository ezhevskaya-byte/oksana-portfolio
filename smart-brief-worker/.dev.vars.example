# Local Cloudflare Worker vars — copy to .dev.vars (never commit real keys).
# .dev.vars is gitignored.

# Provider: openai | yandex
# AI_PROVIDER=yandex

# --- OpenAI (kept for local rollback / dual-provider) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# --- Yandex AI Studio ---
# Secret stays in Cloudflare / local .dev.vars only — never commit:
# YANDEX_API_KEY=
# Folder id is configuration, not the API key:
# YANDEX_FOLDER_ID=b1gkei7lv9uhdqqdtpgc
# YANDEX_MODEL=yandexgpt-5.1/latest
# YANDEX_STRUCTURED_OUTPUT=prompt_json
